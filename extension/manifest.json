{
  "manifest_version": 3,
  "name": "YouTube Floating PiP Toggle",
  "version": "1.1.2",
  "description": "Global hotkey to pop the active YouTube video into a real floating Picture-in-Picture window that stays on top of every app, not just the YouTube tab.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle YouTube floating video",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Toggle floating window for YouTube video",
      "global": true
    }
  }
}
